<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1">Dashboard</h1>
    <p class="text-muted mb-0">Welcome back, <%= user?.username || 'Admin' %>! Here's what's happening.</p>
  </div>
  <div class="d-flex gap-2">
    <span class="badge bg-success fs-6 px-3 py-2"><i class="bi bi-circle-fill me-1"></i>Online</span>
  </div>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
  <div class="col-xl-3 col-md-6">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <p class="text-muted mb-1">Total Users</p>
            <h2 class="mb-0"><%= stats.totalUsers.toLocaleString() %></h2>
          </div>
          <div class="stat-icon bg-primary-light">
            <i class="bi bi-people text-primary"></i>
          </div>
        </div>
        <div class="stat-trend mt-3">
          <span class="text-success"><i class="bi bi-arrow-up"></i> 12.5%</span>
          <span class="text-muted ms-2">vs last month</span>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <p class="text-muted mb-1">Total Orders</p>
            <h2 class="mb-0"><%= stats.totalOrders.toLocaleString() %></h2>
          </div>
          <div class="stat-icon bg-success-light">
            <i class="bi bi-cart-check text-success"></i>
          </div>
        </div>
        <div class="stat-trend mt-3">
          <span class="text-success"><i class="bi bi-arrow-up"></i> 8.2%</span>
          <span class="text-muted ms-2">vs last month</span>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <p class="text-muted mb-1">Revenue</p>
            <h2 class="mb-0">$<%= stats.revenue.toLocaleString() %></h2>
          </div>
          <div class="stat-icon bg-warning-light">
            <i class="bi bi-currency-dollar text-warning"></i>
          </div>
        </div>
        <div class="stat-trend mt-3">
          <span class="text-success"><i class="bi bi-arrow-up"></i> 15.3%</span>
          <span class="text-muted ms-2">vs last month</span>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <p class="text-muted mb-1">Conversion Rate</p>
            <h2 class="mb-0"><%= stats.conversionRate %>%</h2>
          </div>
          <div class="stat-icon bg-info-light">
            <i class="bi bi-graph-up text-info"></i>
          </div>
        </div>
        <div class="stat-trend mt-3">
          <span class="text-danger"><i class="bi bi-arrow-down"></i> 2.1%</span>
          <span class="text-muted ms-2">vs last month</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Charts & Recent Orders -->
<div class="row g-3">
  <!-- Revenue Chart -->
  <div class="col-xl-8">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Revenue Overview</h5>
        <div class="btn-group btn-group-sm" role="group">
          <button type="button" class="btn btn-outline-secondary active">Week</button>
          <button type="button" class="btn btn-outline-secondary">Month</button>
          <button type="button" class="btn btn-outline-secondary">Year</button>
        </div>
      </div>
      <div class="card-body">
        <canvas id="revenueChart" height="300"></canvas>
      </div>
    </div>
  </div>

  <!-- Recent Orders -->
  <div class="col-xl-4">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Recent Orders</h5>
        <a href="#" class="btn btn-link btn-sm p-0">View All</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Amount</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% stats.recentOrders.forEach(order => { %>
                <tr>
                  <td><strong>#<%= order.id %></strong></td>
                  <td><%= order.customer %></td>
                  <td>$<%= order.amount.toFixed(2) %></td>
                  <td>
                    <span class="badge bg-<%= 
                      order.status === 'Completed' ? 'success' : 
                      order.status === 'Processing' ? 'warning' : 
                      order.status === 'Shipped' ? 'info' : 'secondary' 
                    %>">
                      <%= order.status %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Quick Actions -->
<div class="row g-3 mt-4">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Quick Actions</h5>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-3">
            <a href="/dashboard/users" class="quick-action-btn">
              <i class="bi bi-person-plus"></i>
              <span>Add User</span>
            </a>
          </div>
          <div class="col-md-3">
            <a href="#" class="quick-action-btn">
              <i class="bi bi-plus-circle"></i>
              <span>New Order</span>
            </a>
          </div>
          <div class="col-md-3">
            <a href="#" class="quick-action-btn">
              <i class="bi bi-file-earmark-text"></i>
              <span>Generate Report</span>
            </a>
          </div>
          <div class="col-md-3">
            <a href="/dashboard/settings" class="quick-action-btn">
              <i class="bi bi-gear"></i>
              <span>Settings</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
  // Revenue Chart
  const ctx = document.getElementById('revenueChart').getContext('2d');
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: <%- JSON.stringify(stats.chartData.labels) %>,
      datasets: [{
        label: 'Revenue ($)',
        data: <%- JSON.stringify(stats.chartData.revenue) %>,
        borderColor: '#0d6efd',
        backgroundColor: 'rgba(13, 110, 253, 0.1)',
        fill: true,
        tension: 0.4,
        pointBackgroundColor: '#0d6efd',
        pointBorderColor: '#fff',
        pointBorderWidth: 2,
        pointRadius: 5,
        pointHoverRadius: 7
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#fff',
          titleColor: '#212529',
          bodyColor: '#6c757d',
          borderColor: '#dee2e6',
          borderWidth: 1,
          padding: 12,
          displayColors: false,
          callbacks: {
            label: function(context) {
              return '$' + context.parsed.y.toLocaleString();
            }
          }
        }
      },
      scales: {
        x: {
          grid: { display: false },
          ticks: { color: '#6c757d' }
        },
        y: {
          grid: { color: '#f1f3f5' },
          ticks: { 
            color: '#6c757d',
            callback: function(value) { return '$' + value; }
          }
        }
      }
    }
  });
</script>
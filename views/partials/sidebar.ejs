<aside class="sidebar" id="sidebar">
  <div class="brand">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="3" stroke="#a5b4fc" stroke-width="1.6" />
      <path d="M7 15l3-3 2.5 2.5L16 11l1 1" stroke="#818cf8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="8.5" cy="8.5" r="1.4" fill="#6366f1" />
    </svg>
    <span>Poster Admin</span>
  </div>

  <nav class="nav">
    <a href="/dashboard" class="<%= active === 'dashboard' ? 'active' : '' %>">
      <svg class="ico" viewBox="0 0 24 24" fill="none"><path d="M4 13h6V4H4v9Zm0 7h6v-4H4v4Zm10 0h6v-9h-6v9Zm0-16v4h6V4h-6Z" fill="currentColor"/></svg>
      Dashboard
    </a>
    <a href="/posters" class="<%= active === 'posters' ? 'active' : '' %>">
      <svg class="ico" viewBox="0 0 24 24" fill="none"><path d="M4 5h16v11H4z" stroke="currentColor" stroke-width="1.6"/><path d="M4 16l4-4 3 3 4-4 5 5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      Posters
    </a>
    <a href="/users" class="<%= active === 'users' ? 'active' : '' %>">
      <svg class="ico" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.2" stroke="currentColor" stroke-width="1.6"/><path d="M5 20c0-3.3 3.1-5.5 7-5.5s7 2.2 7 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      Admins
    </a>
  </nav>

  <div class="spacer"></div>

  <div class="who">
    Signed in as<br />
    <strong style="color:#e2e8f0"><%= currentAdmin ? currentAdmin.name : '' %></strong>
  </div>
  <form method="post" action="/logout">
    <button type="submit" class="btn btn-ghost btn-block btn-sm">Log out</button>
  </form>
</aside>

<header class="topbar">
  <div style="display:flex; align-items:center; gap:12px">
    <button class="menu-toggle" type="button" data-menu-toggle aria-label="Toggle menu">&#9776;</button>
    <div>
      <h2><%= heading %></h2>
      <% if (typeof subtitle !== 'undefined' && subtitle) { %>
        <div class="sub"><%= subtitle %></div>
      <% } %>
    </div>
  </div>
  <div class="topbar-actions">
    <span class="muted hide-sm">Hi, <%= currentAdmin ? currentAdmin.name : 'Admin' %></span>
    <form method="post" action="/logout">
      <button class="btn btn-ghost btn-sm" type="submit">Log out</button>
    </form>
  </div>
</header>
